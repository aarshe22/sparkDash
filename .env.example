# sparkDash runtime — copy to .env and fill in local values.
# Never commit a real .env (it is gitignored).

PORT=5555
BIND_HOST=0.0.0.0
LLM_PORT=8888
NODE_ENV=production

# Optional outbound proxy (leave blank if unused)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# Optional passphrase or 64-char hex for encrypting SSH passwords / LLM API keys.
# If unset, sparkDash auto-generates config/.secrets-key (gitignored).
SPARKDASH_SECRETS_KEY=

# HAProxy administration (Settings deploy/test/password). If unset, those
# APIs return 503. Paste the same value into Settings → Admin token.
# docker compose restart does not reload this; use: docker compose up -d
SPARKDASH_ADMIN_TOKEN=

# Host filesystem mounts when running in Docker
HOST_PROC_PATH=/host/proc
HOST_SYS_PATH=/host/sys
HOST_ROOT_PATH=/host/root

POLL_INTERVAL_GPU=30000
POLL_INTERVAL_CPU=30000
POLL_INTERVAL_NETWORK=30000
POLL_INTERVAL_STORAGE=30000
POLL_INTERVAL_LLM=30000
POLL_INTERVAL_BANDWIDTH=30000
POLL_INTERVAL_LIVENESS=30000
